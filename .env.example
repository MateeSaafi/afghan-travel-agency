# Copy to .env.local and fill in real values.

# ===== Stripe (test mode) =====
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Only needed if you run `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# The success page also confirms payments via /api/stripe/verify-session,
# so local demos work without webhook forwarding.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===== Firebase Admin SDK =====
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ===== App URL (used for Stripe redirect URLs) =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
